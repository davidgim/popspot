# Copy to .env.local and fill in real values (Supabase dashboard → Project Settings → API).
# .env.local is gitignored — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — Account → Tokens. Secret, server-side only, zero scopes checked
# (geocoding is included on every token by default, no scope needed).
# Never prefix this with NEXT_PUBLIC_ — it must never reach the browser.
MAPBOX_SECRET_TOKEN=

# Mapbox public tile token — Account → Tokens, "styles:tiles" scope only,
# URL-restricted to this app's actual origin(s) (not a secret; safe to
# expose client-side because the URL restriction is the real gate).
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Upstash — Database → REST API section. Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase secret key (formerly "service_role") — Settings → API Keys.
# BYPASSES RLS ENTIRELY. Never imported by any app code in src/ — the app
# relies on RLS as its security layer (see DECISIONS.md, CLAUDE.md). Only
# ever used in throwaway local scripts (e.g. generating test sessions for
# E2E testing). Leave blank unless you're actually running such a script;
# remove/rotate after if you don't want it sitting in .env.local.
SUPABASE_SERVICE_ROLE_KEY=
