# Copy to .env.local and fill in real values (Supabase dashboard → Project Settings → API).
# .env.local is gitignored — never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — Account → Tokens. Secret, server-side only, zero scopes checked
# (geocoding is included on every token by default, no scope needed).
# Never prefix this with NEXT_PUBLIC_ — it must never reach the browser.
MAPBOX_SECRET_TOKEN=

# Upstash — Database → REST API section. Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
